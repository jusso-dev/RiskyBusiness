DATABASE_URL=postgresql://postgres:postgres@localhost:5432/riskybusiness
REDIS_URL=redis://localhost:6379
NEXTAUTH_SECRET=dev-secret

# Logging: debug | info | warn | error (defaults to info in production, debug otherwise)
LOG_LEVEL=info

# AI provider: mock | openai
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# Timeout for AI provider calls in milliseconds
AI_TIMEOUT_MS=20000

# Worker concurrency for BullMQ jobs
WORKER_CONCURRENCY=4
